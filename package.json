{
  "name": "library-ioc-app",
  "version": "1.0.0",
  "description": "Library application with TypeScript and IoC container",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "type-check": "tsc --noEmit"
  },
  
  "keywords": [
    "typescript",
    "ioc",
    "inversify",
    "express",
    "library"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "inversify": "^6.0.1",
    "reflect-metadata": "^0.1.13",
    "mongodb": "^5.7.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "@types/node": "^20.5.0",
    "@types/express": "^4.17.17"
  }
}
