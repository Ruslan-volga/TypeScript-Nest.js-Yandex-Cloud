<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
        }
        
        .error-container {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 40px;
            max-width: 600px;
            width: 100%;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }
        
        .error-code {
            font-size: 6em;
            font-weight: 700;
            margin-bottom: 20px;
            color: #ffcc00;
            text-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }
        
        h1 {
            font-size: 2em;
            margin-bottom: 20px;
        }
        
        .error-message {
            font-size: 1.2em;
            margin-bottom: 30px;
            line-height: 1.6;
            opacity: 0.9;
        }
        
        .button {
            display: inline-block;
            padding: 15px 30px;
            background: #ffcc00;
            color: #333;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            margin: 10px;
            transition: all 0.3s ease;
        }
        
        .button:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 204, 0, 0.4);
            background: #ffd633;
        }
        
        .error-details.hidden {
        display: none;
    }
    .error-details:not(.hidden) {
        margin-top: 30px;
        padding: 20px;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 10px;
        text-align: left;
        font-family: monospace;
        font-size: 0.9em;
        overflow-x: auto;
    }
        
        
        .user-status {
            margin-top: 20px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            font-size: 0.9em;
        }
        
        footer {
            margin-top: 30px;
            opacity: 0.7;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-code">
            <%= error && error.status ? error.status : '500' %>
        </div>
        
        <h1><%= title %></h1>
        
        <div class="error-message">
            <%= message %>
        </div>
        
        <% if (user) { %>
            <div class="user-status">
                <p>Вы авторизованы как: <strong><%= user.displayName %></strong></p>
            </div>
        <% } %>
        
        <div class="button-group">
            <a href="/" class="button">🏠 На главную</a>
            <% if (!user) { %>
                <a href="/auth/yandex" class="button">🔑 Войти</a>
            <% } else { %>
                <a href="/profile" class="button">👤 Профиль</a>
                <a href="/logout" class="button">🚪 Выйти</a>
            <% } %>
        </div>
        
        <% if (error && Object.keys(error).length > 0) { %>
            <div class="error-details">
                <h3>Детали ошибки:</h3>
                <pre><%= JSON.stringify(error, null, 2) %></pre>
            </div>
        <% } %>
        
        <footer>
            <p>© <%= new Date().getFullYear() %> Яндекс OAuth Demo</p>
            <p>Версия 1.0.0 • Ошибка: <%= error && error.status ? error.status : 'Internal' %></p>
        </footer>
    </div>
</body>
</html>